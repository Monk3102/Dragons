rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access globally
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Blueprint
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidNote(data) {
      return data.keys().hasAll(['id', 'userId', 'dragonId', 'text', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'dragonId', 'dragonName', 'text', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.dragonId is string && data.dragonId.size() <= 64 &&
        data.text is string && data.text.size() <= 10000 &&
        data.status in ['Formidable', 'Acknowledged', 'Weakened', 'Transmuted'] &&
        (!('dragonName' in data) || (data.dragonName is string && data.dragonName.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'content']) &&
        data.keys().hasOnly(['id', 'userId', 'dragonId', 'role', 'content', 'modelUsed', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.role in ['user', 'model', 'system'] &&
        data.content is string && data.content.size() <= 15000 &&
        (!('dragonId' in data) || (data.dragonId is string && data.dragonId.size() <= 64)) &&
        (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // User Profile Document - Strict Owner Only
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == existing().uid && incoming().uid == userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Confrontation Notes Subcollection - Strict Owner Only
      match /notes/{noteId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && isValidNote(incoming()) && incoming().id == noteId && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && isValidNote(incoming()) && incoming().id == noteId && incoming().userId == existing().userId && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }

      // Chat Messages Subcollection - Strict Owner Only
      match /chats/{chatId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(chatId) && isValidChatMessage(incoming()) && incoming().id == chatId && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(chatId) && isValidChatMessage(incoming()) && incoming().id == chatId && incoming().userId == existing().userId && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(chatId);
      }
    }
  }
}
