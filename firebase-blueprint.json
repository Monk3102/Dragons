{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile in the dragon void.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "ConfrontationNote": {
      "title": "ConfrontationNote",
      "description": "Reflective confrontation journal entry for a specific dragon.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "dragonId": { "type": "string", "maxLength": 64 },
        "dragonName": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["Formidable", "Acknowledged", "Weakened", "Transmuted"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "dragonId", "text", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Conversation thread message for Gemini chat counsel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "dragonId": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string", "maxLength": 8000 },
        "modelUsed": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "role", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user document containing profile data."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "ConfrontationNote",
      "description": "User notes and reflection chronicle for each dragon."
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Persisted Gemini chat history for the user."
    }
  }
}
